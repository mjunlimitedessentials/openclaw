# J.A.R.V.I.S. 2 — environment secrets
# Copy to ~/.openclaw/.env and fill in ONLY what you use. Keep this out of git.
# OpenClaw reads ~/.openclaw/.env for the daemon; MCP servers read their own env
# (some via mcporter). Never put secrets in the .json config files.

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token   # openssl rand -hex 32

# -----------------------------------------------------------------------------
# Model provider (pick at least one; Anthropic recommended)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Front door: Telegram (from @BotFather)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional business channels
# WHATSAPP_...=            # see docs.openclaw.ai for the WhatsApp channel
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=T0000000

# -----------------------------------------------------------------------------
# Voice
# -----------------------------------------------------------------------------
# STT (you -> JARVIS): whisper skill. If using the API variant:
# OPENAI_API_KEY=sk-...            # reused for whisper-api
# TTS (JARVIS -> you): Edge needs no key. For premium voice use ElevenLabs:
# ELEVENLABS_API_KEY=...

# -----------------------------------------------------------------------------
# Sub-agent integrations (MCP). Set what you wire in mcporter.
# -----------------------------------------------------------------------------
# Google (Gmail + Calendar + Drive) — OAuth creds path for the MCP servers:
# GOOGLE_OAUTH_CREDENTIALS_PATH=/absolute/path/to/gcp-oauth.keys.json

# Supabase (long-term memory + CRM)
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_ACCESS_TOKEN=sbp_...

# Content / media studio
# GAMMA_API_KEY=...
# HIGGSFIELD_API_KEY=...
# VIDIQ_API_KEY=...
# Canva: OAuth via its connector (no static key here)

# Forms / notes
# JOTFORM_API_KEY=...
